# Production settings for pos.kopiketo.com — copy to .env on the server and
# fill in the DB_* values (same user/password as the v1 site's .env).
APP_NAME="Kopiketo POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.kopiketo.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# The existing POS database (hosting allows only 2 databases). v2 tables live
# here next to the renamed v1_* tables (see docs/deploy/1-rename-v1-tables.sql).
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_TIMEZONE=+07:00
DB_DATABASE=k3346760_kopiketopos
DB_USERNAME=
DB_PASSWORD=

# Where `php artisan legacy:import` reads v1 data: same database, v1_ tables
LEGACY_DB_DATABASE=k3346760_kopiketopos
LEGACY_DB_PREFIX=v1_

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# Leave empty unless the site sits behind a proxy that rewrites https to http
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
